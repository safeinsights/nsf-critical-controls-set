__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
build/
dist/
.Python
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments (any common location/name)
venv/
.venv/
env/
.env/
ENV/

